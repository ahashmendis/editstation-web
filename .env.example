# Copy to .env.local and fill in. Never commit real values.
# Local values are printed by `npm run db:start` (supabase start).

# Public: safe to expose to the browser. Access is enforced by RLS, not by hiding this key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Never prefix with NEXT_PUBLIC_, never import from client code.
# Not used in Phase 0; only introduced if a feature genuinely needs it.
SUPABASE_SECRET_KEY=
