# Copy to .env.local and fill in. Never commit real values.
# Local values are printed by `npm run db:start` (supabase start).

# Public: safe to expose to the browser. Access is enforced by RLS, not by hiding this key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Never prefix with NEXT_PUBLIC_, never import from client code.
# Used only by the notification email worker (src/lib/supabase/service.ts, route
# /api/cron/send-emails), whose database functions accept no other caller.
SUPABASE_SECRET_KEY=

# Notification emails (docs/RUNBOOKS.md "Notification emails"). All server-only.
# Shared secret the scheduler sends as "Authorization: Bearer <value>". Long and random
# (e.g. `openssl rand -hex 32`). If unset, the worker route rejects every request.
CRON_SECRET=
# Brevo transactional API key (Brevo > SMTP & API > API keys). If unset, the route sends
# nothing and leaves the queue untouched.
BREVO_API_KEY=
# Sender, "Name <address>" on a domain verified in Brevo.
# Default: EDITSTATION <no-reply@editstation.work>
EMAIL_FROM=

# SEO (docs/SEO/README.md). Both are read at build time; redeploy after changing them.
# Canonical origin of the production site. Leave unset until the domain is registered
# (falls back to the current Vercel alias).
SITE_URL=
# Search engines are blocked unless this is exactly "on". Open it only at launch.
SEO_INDEXING=
