# Copy to .env.local and fill in. Never commit real values.
# Local values are printed by `npm run db:start` (supabase start).

# Public: safe to expose to the browser. Access is enforced by RLS, not by hiding this key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Never prefix with NEXT_PUBLIC_, never import from client code.
# Not used in Phase 0; only introduced if a feature genuinely needs it.
SUPABASE_SECRET_KEY=

# SEO (docs/SEO/README.md). Both are read at build time; redeploy after changing them.
# Canonical origin of the production site. Leave unset until the domain is registered
# (falls back to the current Vercel alias).
SITE_URL=
# Search engines are blocked unless this is exactly "on". Open it only at launch.
SEO_INDEXING=
